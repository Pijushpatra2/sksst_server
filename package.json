{
  "name": "puja-software-server",
  "version": "1.0.0",
  "description": "Puja Software — REST API Server (Node.js + TypeScript + Express)",
  "main": "dist/server.js",
  "author": "Puja Software",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "rimraf dist && tsc --project tsconfig.json && tsc-alias",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "start:cluster": "npm run build && pm2 start ecosystem.config.js --env production",
    "stop:cluster": "pm2 stop puja-server",
    "reload:cluster": "pm2 reload puja-server",
    "logs": "pm2 logs puja-server",
    "monit": "pm2 monit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.57",
    "@types/uuid": "^10.0.0",
    "rimraf": "^5.0.5",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
